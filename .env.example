# Copy this file to .env (at the repo root) to customize docker-compose.yml.
#
# This is separate from backend/.env.example and frontend/.env.example,
# which configure each service individually for non-Docker / local dev use.
# This file only affects values that docker-compose.yml itself reads at
# build time.

# The URL the BROWSER will use to reach the backend -- not the internal
# Docker network address. If you're self-hosting on a LAN and accessing the
# frontend from another machine, this needs to be your host's actual
# reachable address, e.g.:
# VITE_API_URL=http://192.168.1.50:8000
VITE_API_URL=http://localhost:8000

# ── Call audio (v2.2.0) ───────────────────────────────────────────────────
# Reconstruct call audio from RTP in uploaded captures and save it as WAV
# (G.711 PCMU/PCMA only), playable from the call's Media tab.
# OFF by default: recording calls may carry legal obligations where you live.
# Docker: set it here (root .env). Files are stored in ./data/recordings.
SAVE_CALL_AUDIO=false

# ── v2.3.0 live capture (docker compose --profile capture up -d) ──
# Network interface that receives the mirrored (SPAN) traffic. Differs per machine
# (eth1, enp2s0, ens19 ...). List yours with:
#   docker compose --profile capture run --rm capture python -m app.capture --list-interfaces
CAPTURE_INTERFACE=eth1
# BPF filter; the default captures SIP on 5060 and all UDP (RTP uses dynamic ports)
# CAPTURE_FILTER=udp or tcp port 5060
# Record call audio for live calls (check the recording laws that apply to you)
LIVE_RECORDING_ENABLED=true

# Recording retention: delete recordings older than N days (0 = keep forever) and/or
# keep the recordings folder under N GB (oldest deleted first, 0 = no cap).
# Call records and quality metrics are always kept.
RECORDINGS_RETENTION_DAYS=180
RECORDINGS_MAX_GB=0

# Login (v2.3.0): the first admin account is created on first start only.
# If ADMIN_PASSWORD is empty a random one is generated and shown once in the backend log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional token signing key; if empty one is generated and kept in ./data/.auth_secret
AUTH_SECRET=
